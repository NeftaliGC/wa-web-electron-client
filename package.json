{
	"name": "wa-web-electron-client",
	"version": "0.2.0",
	"description": "Unofficial WhatsApp Web client built with Electron",
	"main": "main/index.js",
	"private": true,
	"desktopName": "wa-web-electron-client.desktop",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "electron .",
		"build": "electron-builder",
		"build:appimage": "electron-builder --linux AppImage",
		"build:deb": "electron-builder --linux deb",
		"build:pacman": "electron-builder --linux pacman"
	},
	"author": {
		"name": "Nintech",
		"email": "nintech1912@gmail.com"
	},
	"homepage": "https://nintech.dev",
	"license": "MIT",
	"build": {
		"appId": "com.nintech.wa-web-electron-client",
		"productName": "Unofficial WhatsApp Web Electron Client",
		"files": [
			"main/**/*",
			"preload/**/*",
			"renderer/**/*",
			"assets/**/*",
			"package.json"
		],
		"asarUnpack": [
			"assets/WhatsApp_icon.png"
		],
		"linux": {
			"target": [
				"AppImage",
				"deb",
				"pacman"
			],
			"icon": "assets/WhatsApp_icon.png",
			"category": "Network"
		}
	},
	"devDependencies": {
		"electron": "^41.5.0",
		"electron-builder": "^26.4.0"
	},
	"dependencies": {
		"electron-store": "^11.0.2"
	}
}
